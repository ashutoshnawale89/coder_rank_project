SERVER_PORT=8080

# MySQL
DB_URL=jdbc:mysql://localhost:3306/coder_rank?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change_me

# JWT — use a base64-encoded secret of at least 256 bits
JWT_SECRET=replace_with_a_long_random_base64_secret_at_least_32_bytes
JWT_EXPIRATION_MS=86400000

# Docker sandbox
DOCKER_ENABLED=true
DOCKER_TIMEOUT=10
DOCKER_MEMORY=256m
DOCKER_CPUS=0.5
DOCKER_PIDS_LIMIT=64
DOCKER_WORKDIR=/tmp/coderank

# Executor
EXECUTOR_CORE=4
EXECUTOR_MAX=8
EXECUTOR_QUEUE=20

# Rate limiting (per-user requests / minute on /api/execute and /api/questions/{id}/solve)
RATE_LIMIT_RPM=10

# CORS — origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin seed — only created on first start if no ADMIN exists AND ADMIN_PASSWORD is set
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@coderank.local
ADMIN_PASSWORD=change_me_strong
